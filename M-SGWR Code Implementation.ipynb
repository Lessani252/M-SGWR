   "source": [
    "from sgwr import MSGWR, Sel_BW\n",
    "import pandas as pd\n",
    "import numpy as np \n",
    "\n",
    "df = pd.read_csv(r\"Data.csv\")\n",
    "\n",
    "columns = df.columns[3:]\n",
    "print('Predictors:', columns)\n",
    "\n",
    "g_y = df[df.columns[2]].values.reshape(-1, 1) ## Dependent variable\n",
    "g_x = df[columns].values ## Predictors              \n",
    "\n",
    "u = df[df.columns[0]].values  ## x-coordinate                \n",
    "v = df[df.columns[1]].values  ## y-coordinate  \n",
    "\n",
    "## If you decide to standardize your data, you can activate the commands below. \n",
    "# scaler = StandardScaler()\n",
    "# g_x = scaler.fit_transform(g_x)\n",
    "# g_y = scaler.fit_transform(g_y)\n",
    "\n",
    "g_coords = list(zip(u, v))\n",
    "\n",
    "## Predictors for attribute weight matrix construction\n",
    "data = g_x \n",
    "\n",
    "## divide-and-conquer approach for alpha optimization\n",
    "# selector = Sel_BW(g_coords, g_y, g_x, data, multi=True, alphacurve=True) \n",
    "\n",
    "## greedy hill-climbing approach with fixed step sizes for alpha optimization\n",
    "selector = Sel_BW(g_coords, g_y, g_x, data, columns, multi=True) \n",
    "\n",
    "## Using AICc parameter as a measure of optimization\n",
    "msgwr_bw = selector.search()\n",
    "\n",
    "print('Optimal bandwidths:', msgwr_bw)\n",
    "print('Optimal alphas:', np.array([v[-1] for v in selector.bw[-1].values()])) \n",
    "\n",
    "msgwr_fit = MSGWR(g_coords, g_y, g_x, data, selector).fit()\n",
    "\n",
    "print('R2: ', msgwr_fit.R2)\n",
    "print('Adjusted R2: ', msgwr_fit.adj_R2)\n",
    "print('AICc: ', msgwr_fit.aicc)\n",
    "print('BIC: ', msgwr_fit.bic)\n",
    "print('RSS:', np.sum(msgwr_fit.resid_response**2))"
   ]
  },
